# The release CI runs for a v* tag (make release). A plain tag (v0.1.0) goes to TestFlight
# and App Review and is released when approved; a tag with a suffix (v0.1.0-beta.1) goes to
# TestFlight only. What needs no Apple account (whether the tag may ship, its version, the
# release notes) is scripts/release.py. Secrets come from the GitHub environment app-store.

require "base64"
require "json"
require "plist"
require "securerandom"
require "tmpdir"
require_relative "store_setup"

default_platform(:mac)
skip_docs

ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "Xippi.xcodeproj")
RELEASE = File.join(ROOT, "scripts", "release.py")
KEYCHAIN = "xippi-release.keychain"

def env!(name)
  value = ENV[name].to_s
  UI.user_error!("#{name} is not set") if value.empty?
  value
end

def delete_release_keychain
  path = File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db")
  delete_keychain(name: KEYCHAIN) if File.exist?(path)
end

platform :mac do
  desc "Build, sign and upload the release a v* tag names; a plain tag also goes to App Review"
  lane :tag do
    tag = ENV["RELEASE_TAG"].to_s.empty? ? env!("GITHUB_REF_NAME") : ENV["RELEASE_TAG"]

    # Before anything is built: the tag may ship, and its notes can be written.
    sh("python3", RELEASE, "check", tag)
    info = JSON.parse(sh("python3", RELEASE, "version", tag, log: false))
    version = info.fetch("version")
    prerelease = info.fetch("prerelease")
    notes_path = File.join(ROOT, "fastlane", "metadata", "en-US", "release_notes.txt")
    sh("python3", RELEASE, "notes", tag, notes_path)
    notes = File.read(notes_path).strip

    api_key = app_store_connect_api_key(
      key_id: env!("ASC_KEY_ID"),
      issuer_id: env!("ASC_ISSUER_ID"),
      key_content: env!("ASC_KEY_P8"),
      is_key_content_base64: true
    )
    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    UI.user_error!("No app #{app_identifier} in App Store Connect: create it first") unless app
    StoreSetup.prepare(
      app, Spaceship::ConnectAPI.client.tunes_request_client,
      ->(outcome, text) { outcome == :done ? UI.success(text) : UI.important(text) },
      france: StoreSetup.sold_in_france?(Plist.parse_xml(File.join(ROOT, "App", "Info.plist")))
    )

    # The two certificates and the profile, from secrets, in a keychain of the run's own.
    work = Dir.mktmpdir("xippi-release")
    keychain_password = SecureRandom.hex(32)
    create_keychain(
      name: KEYCHAIN,
      password: keychain_password,
      default_keychain: false,
      unlock: true,
      timeout: 0,
      lock_when_sleeps: false,
      add_to_search_list: true
    )
    { "DIST_CERT" => "distribution.p12", "INSTALLER_CERT" => "installer.p12" }.each do |secret, file|
      path = File.join(work, file)
      File.binwrite(path, Base64.decode64(env!("#{secret}_P12")))
      import_certificate(
        certificate_path: path,
        certificate_password: env!("#{secret}_PASSWORD"),
        keychain_name: KEYCHAIN,
        keychain_password: keychain_password
      )
    end
    profile = File.join(work, "Xippi.provisionprofile")
    File.binwrite(profile, Base64.decode64(env!("MAS_PROFILE")))
    install_provisioning_profile(path: profile)
    profile_name = FastlaneCore::ProvisioningProfile.name(profile)

    # One number for the whole life of the app: the newest upload's, plus one.
    build_number = latest_testflight_build_number(
      api_key: api_key,
      platform: "osx",
      initial_build_number: 0
    ).to_i + 1

    # The app target signs with the distribution certificate and profile for this build
    # only; the project file is put back afterwards.
    pbxproj = File.join(PROJECT, "project.pbxproj")
    original = File.read(pbxproj)
    begin
      update_code_signing_settings(
        path: PROJECT,
        targets: ["Xippi"],
        build_configurations: ["Release"],
        use_automatic_signing: false,
        team_id: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name
      )
      pkg = build_mac_app(
        project: PROJECT,
        scheme: "Xippi",
        configuration: "Release",
        export_method: "app-store",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: { "eu.xippi.Xippi" => profile_name }
        },
        # As the build job builds: the packages' macros and plugins run without a prompt.
        xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number} " \
                "-skipMacroValidation -skipPackagePluginValidation",
        output_directory: File.join(ROOT, "fastlane", "build"),
        output_name: "Xippi"
      )
    ensure
      File.write(pbxproj, original)
    end

    # Internal testers get it once it is processed; "What to Test" is the notes.
    upload_to_testflight(
      api_key: api_key,
      app_platform: "osx",
      pkg: pkg,
      changelog: notes,
      distribute_external: false,
      skip_waiting_for_build_processing: false
    )

    next if prerelease

    # Store text, screenshots, age rating and "What's New" (not on a first version), then
    # App Review.
    deliver(
      api_key: api_key,
      platform: "osx",
      app_version: version,
      build_number: build_number.to_s,
      skip_binary_upload: true,
      metadata_path: File.join(ROOT, "fastlane", "metadata"),
      screenshots_path: File.join(ROOT, "fastlane", "screenshots"),
      overwrite_screenshots: true,
      app_rating_config_path: File.join(ROOT, "fastlane", "age_rating.json"),
      app_review_information: {
        first_name: env!("REVIEW_FIRST_NAME"),
        last_name: env!("REVIEW_LAST_NAME"),
        phone_number: env!("REVIEW_PHONE"),
        demo_user: env!("REVIEW_DEMO_USER"),
        demo_password: env!("REVIEW_DEMO_PASSWORD")
      },
      # Other people's messages, pictures and links: third-party content.
      submission_information: { content_rights_contains_third_party_content: true },
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      force: true
    )
  end

  after_all do
    delete_release_keychain
  end

  error do
    delete_release_keychain
  end
end
