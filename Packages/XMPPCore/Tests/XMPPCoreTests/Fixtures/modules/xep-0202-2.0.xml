<?xml version='1.0' encoding='UTF-8'?>
<!-- XEP-0202: Entity Time, version 2.0 (2009-09-11). Examples copied verbatim from
     https://xmpp.org/extensions/xep-0202.html; each 'source' names the XEP's example number. -->
<examples xep='0202' version='2.0'>
<example name='request' source='Example 1. Querying Another Entity for the Local Time'><![CDATA[
<iq type='get'
    from='romeo@montague.net/orchard'
    to='juliet@capulet.com/balcony'
    id='time_1'>
  <time xmlns='urn:xmpp:time'/>
</iq>
]]></example>
<example name='response' source='Example 2. A Response to the Query'><![CDATA[
<iq type='result'
    from='juliet@capulet.com/balcony'
    to='romeo@montague.net/orchard'
    id='time_1'>
  <time xmlns='urn:xmpp:time'>
    <tzo>-06:00</tzo>
    <utc>2006-12-19T17:58:35Z</utc>
  </time>
</iq>
]]></example>
</examples>
