root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.swift]
indent_size = 4

[{*.yml,*.yaml,*.json,*.lua,.swift-format}]
indent_size = 2

[Makefile]
indent_style = tab

# Written by Xcode
[{*.pbxproj,*.plist,*.entitlements,*.xcprivacy}]
indent_style = tab

[*.xcscheme]
indent_size = 3

[*.md]
trim_trailing_whitespace = false
